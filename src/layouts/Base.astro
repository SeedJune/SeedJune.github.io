---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {/*
      Must stay inline and stay here, above the body. It sets the theme before
      the first paint; loaded as a module or moved lower it would run after the
      page has already been painted in the wrong theme, and every visit in dark
      mode would start with a flash of white.

      Precedence: an explicit earlier choice wins, otherwise the operating
      system's preference decides.
    */}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* storage blocked (Safari private mode) — fall through to the OS */
        }

        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';

        /* Marks that scripting is alive, before anything is painted. The theme
           toggle is hidden until this lands, so with JavaScript off it never
           appears rather than appearing as a button that cannot do anything —
           the same rule the Blogs filter and the About language switch follow.
           Setting it here instead of from the button's own script means there
           is no frame where the button is missing and then pops in. */
        document.documentElement.dataset.js = '1';
      })();
    </script>
  </head>

  <body>
    <!-- Points at <main> rather than at #about: the About section only exists
         on the home page, and this layout now also wraps blog posts. -->
    <a class="skip" href="#content">Skip to content</a>

    <ThemeToggle />

    <div class="shell">
      <Sidebar />
      <main class="main" id="content">
        <slot />
      </main>
    </div>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10;
        padding: var(--sp-2) var(--sp-4);
        background: var(--c-bg);
        border: 1px solid var(--c-blue);
        border-radius: var(--r-sm);
      }
      .skip:focus {
        left: var(--sp-4);
        top: var(--sp-4);
      }

      .shell {
        display: grid;
        grid-template-columns: 1fr;
        min-height: 100dvh;
      }

      .main {
        background: var(--c-bg);
        padding: var(--sp-12) var(--w-gutter) var(--sp-16);
        min-width: 0;
      }

      /* Content is left-aligned inside the column; only the column is placed. */
      .main > :global(*) {
        max-width: var(--w-content);
      }

      @media (min-width: 900px) {
        .shell {
          grid-template-columns: var(--w-sidebar) minmax(0, 1fr);
        }
        .main {
          padding: var(--sp-16) var(--sp-12);
        }
      }

      @media (min-width: 1280px) {
        .main {
          padding: var(--sp-16);
        }
      }
    </style>
  </body>
</html>
