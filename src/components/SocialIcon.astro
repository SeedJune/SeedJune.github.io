---
/**
 * The glyph in front of each sidebar social link.
 *
 * Brand marks come from real SVG files in src/assets/icons/ and are inlined
 * with `?raw` rather than loaded through <img>. Inlining costs no extra
 * requests (they total a few KB), and more importantly it lets CSS size them —
 * the source files carry width="2500" attributes that an <img> would obey.
 *
 * All four are fixed-colour brand marks rather than `currentColor` glyphs, so
 * they keep their own identity and do not tint on hover — that is the point of
 * a logo. Each one was checked against both sidebar surfaces (#e8f2fb light,
 * #0f1d2a dark); the earlier GitHub wordmark had to be replaced because it was
 * pure black and vanished entirely on the dark theme.
 *
 * Anything unknown falls back to a generic chain-link glyph, so adding a
 * social without an icon leaves the row aligned instead of ragged.
 */
import gmail from '../assets/icons/gmail.svg?raw';
import github from '../assets/icons/github.svg?raw';
import csdn from '../assets/icons/csdn.svg?raw';
import rednote from '../assets/icons/rednote.svg?raw';

interface Props {
  name?: string;
}

const { name = '' } = Astro.props;

const brandMarks: Record<string, string> = {
  email: gmail,
  github,
  csdn,
  rednote,
};

/* `?raw` hands back the file byte for byte, comments and all. Those comments
   explain the source files to a human editing them; shipping them inside every
   page's HTML helps nobody. */
const strip = (svg: string) => svg.replace(/<!--[\s\S]*?-->/g, '').trim();

const brand = brandMarks[name] ? strip(brandMarks[name]) : undefined;
---

{
  brand ? (
    <span class="icon" set:html={brand} />
  ) : (
    <span class="icon">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5" />
        <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5" />
      </svg>
    </span>
  )
}

<style>
  .icon {
    flex: none;
    display: flex;
    align-items: center;
    /* A fixed box keeps the labels in a straight line even though the marks
       are not all square — Gmail is 1.28:1, the others near 1:1. */
    width: 1.25rem;
    height: 1rem;
  }

  /*
    :global because the brand marks arrive through set:html and so never get
    Astro's scoping attribute. Height-driven with width:auto so nothing is
    squashed; this also overrides the width="2500" baked into the source files,
    which is exactly what an <img> could not do.
  */
  .icon > :global(svg) {
    display: block;
    height: 1rem;
    width: auto;
    max-width: 1.25rem;
  }
</style>
