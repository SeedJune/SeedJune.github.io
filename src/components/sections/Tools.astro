---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import EmptyState from '../EmptyState.astro';
import ToolCard from '../ToolCard.astro';

const tools = (await getCollection('tools'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Section id="tools" title="Tools" accent="blue">
  <p class="lede">Small things I built that you can actually play with.</p>

  {
    tools.length === 0 ? (
      <EmptyState
        message="Nothing here yet."
        hint="Copy src/content/tools/_template.md, rename it without the underscore, and fill it in."
      />
    ) : (
      <div class="grid">
        {tools.map((entry) => (
          <ToolCard entry={entry} />
        ))}
      </div>
    )
  }
</Section>

<style>
  .lede {
    margin-bottom: var(--sp-6);
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
