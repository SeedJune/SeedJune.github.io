---
import Section from '../Section.astro';
import EmptyState from '../EmptyState.astro';
import Pager from '../Pager.astro';
import { news } from '../../data/site';
import { formatMonth } from '../../utils/date';
---

<Section id="news" title="News" accent="blue" collapsible>
  {
    news.length === 0 ? (
      <EmptyState
        message="Nothing to report just yet."
        hint="Add entries to the `news` array in src/data/site.ts — newest first."
      />
    ) : (
      <Pager size={8} label="News">
        <ul class="news" data-pager-list>
          {news.map((item) => (
            <li class="news__item">
              <span class="news__date">{formatMonth(item.date)}</span>
              <span class="news__text">{item.text}</span>
            </li>
          ))}
        </ul>
      </Pager>
    )
  }
</Section>

<style>
  .news {
    display: flex;
    flex-direction: column;
  }

  .news__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-1);
    padding-block: var(--sp-3);
    border-top: 1px solid var(--c-border);
  }

  /* `hidden` is set by the pager; `display: grid` above would beat the UA
     rule, so it has to be restated. */
  .news__item[hidden] {
    display: none;
  }

  /* :first-child covers the no-JS case, [data-first] the paged one — on page
     two the markup's first child is hidden, so the two never collide. */
  .news__item:first-child,
  .news__item[data-first] {
    border-top: none;
    padding-top: 0;
  }

  .news__date {
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .news__text {
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
  }

  @media (min-width: 640px) {
    .news__item {
      grid-template-columns: 10.5rem minmax(0, 1fr);
      gap: var(--sp-4);
    }
  }
</style>
