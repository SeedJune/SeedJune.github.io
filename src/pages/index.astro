---
import Base from '../layouts/Base.astro';
import About from '../components/sections/About.astro';
import News from '../components/sections/News.astro';
import Publications from '../components/sections/Publications.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Blogs from '../components/sections/Blogs.astro';
import Gallery from '../components/sections/Gallery.astro';
---

<!--
  The whole site, in order. To add a section later: create it under
  src/components/sections/, add one line here, and add one line to
  `navItems` in src/components/Nav.astro. Nothing else needs to change.
-->
<Base>
  <About />
  <News />
  <Publications />
  <Experience />
  <Projects />
  <Blogs />
  <Gallery />
</Base>
