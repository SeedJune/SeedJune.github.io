---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { formatDay, isoDay } from '../../utils/date';
import { blogSeries } from '../../data/site';

/* KaTeX's stylesheet, imported here rather than in global.css so the home page
   does not carry it. Vite rewrites the font URLs inside it and emits the woff2
   files alongside the rest of the build, so the maths fonts are served from
   this domain — no CDN, nothing to go down or to leak a visitor's IP. */
import 'katex/dist/katex.min.css';

/* One page per published post. Drafts get no page at all — not a hidden one,
   no page — so an unfinished post cannot be reached by guessing its URL. */
export async function getStaticPaths() {
  const posts = (await getCollection('blogs')).filter(
    (entry) => !entry.data.draft,
  );

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, date, summary, series, tags, cover, coverAlt } = entry.data;
const { Content } = await render(entry);

const seriesLabel = blogSeries.find((s) => s.id === series)?.label ?? series;
---

<Base title={`${title} — Blog`} description={summary}>
  <article class="post">
    <header class="post__head">
      <a class="post__back" href="/#blogs">← All posts</a>

      <p class="post__meta">
        <span class="post__series">{seriesLabel}</span>
        <time datetime={isoDay(date)}>{formatDay(date)}</time>
      </p>

      <h1 class="post__title">{title}</h1>
      <p class="post__summary">{summary}</p>

      {tags.length > 0 && <TagList tags={tags} tone="blue" />}
    </header>

    {
      cover && (
        <div class="post__cover media">
          <Image
            src={cover}
            alt={coverAlt}
            widths={[720, 1440]}
            sizes="(max-width: 759px) calc(100vw - 40px), 720px"
            format="webp"
            quality={80}
            loading="eager"
          />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="post__foot">
      <a href="/#blogs">← Back to all posts</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .post__head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .post__back {
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .post__back:hover {
    text-decoration: underline;
  }

  .post__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .post__series {
    color: var(--c-blue);
    font-weight: 600;
  }

  .post__title {
    font-size: var(--fs-2xl);
    color: var(--c-ink);
  }

  .post__summary {
    color: var(--c-ink-muted);
  }

  .post__cover {
    --media-ratio: 16 / 9;
    border-radius: var(--r-md);
  }

  .post__foot {
    padding-top: var(--sp-6);
    border-top: 1px solid var(--c-border);
    font-size: var(--fs-sm);
  }

  /* ------------------------------------------------------------------
     Prose. global.css strips margins off <p> and bullets off <ul> for the
     card layouts, which is right everywhere except here — this is the one
     place on the site where raw Markdown becomes the page, so the defaults
     have to be put back. :global because the markup comes from <Content />.
     ------------------------------------------------------------------ */
  /*
    One width for everything in the article — text, images, code, formulas all
    share the same left and right edge. An earlier version let images break out
    wider than the text; it gave images room but produced two competing column
    edges down the page, which read as a mistake rather than as emphasis.

    900px is the compromise: wide enough that a diagram is legible and the
    right-hand gap is no longer conspicuous, narrow enough that a line of text
    stays scannable. It is a single number — tune it here and text and images
    move together, which is the whole point.

    Below 900px + padding the column is simply narrower than this cap, so the
    article is fluid on every screen down to a phone without a media query.
  */
  .post {
    --w-main: 900px;
  }

  .prose {
    color: var(--c-ink);
  }

  .prose > :global(* + *) {
    margin-top: var(--sp-4);
  }

  .prose :global(h2) {
    margin-top: var(--sp-8);
    font-size: var(--fs-xl);
  }

  .prose :global(h3) {
    margin-top: var(--sp-6);
    font-size: var(--fs-lg);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--sp-6);
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: var(--sp-2);
  }

  .prose :global(img) {
    border-radius: var(--r-md);
  }

  .prose :global(blockquote) {
    margin: 0;
    padding-left: var(--sp-4);
    border-left: 3px solid var(--c-blue-soft);
    color: var(--c-ink-muted);
  }

  .prose :global(code) {
    padding: 0.15em 0.4em;
    border-radius: var(--r-sm);
    background: var(--c-bg-tint);
    font-size: 0.9em;
  }

  .prose :global(pre) {
    padding: var(--sp-4);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow-x: auto;
  }

  /* The highlighted block sets its own background; the inline chrome above
     would double up on it. */
  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: var(--fs-sm);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border);
    text-align: left;
  }

  /*
    A display formula is one long unbreakable line. On a phone the widest ones
    here (the chain-rule expansion of the reparameterisation gradient) are far
    wider than the column, and without this they would push the whole page
    sideways. Scrolling the formula alone keeps the body text where it is.

    overflow-y stays hidden: `auto` on both axes makes some browsers reserve
    room for a horizontal scrollbar and clip tall fractions.
  */
  .prose :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25rem;
  }

  /* ---- footnotes ------------------------------------------------------
     GitHub-flavoured Markdown turns `[^1]` into a superscript link and
     collects the definitions into <section class="footnotes"> at the end of
     the document, with backlinks. None of it is styled by default here. */

  /*
     GFM labels that section with <h2 class="sr-only">Footnotes</h2>. This
     project had no .sr-only rule, so that heading rendered as a full-size
     heading. Hiding it visually while leaving it for screen readers is what
     the class means, and it is how GitHub itself renders the block: a rule
     and a numbered list, no visible label.
  */
  .prose :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .prose :global(.footnotes) {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--c-border);
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
  }

  /* Jumping to a note from the superscript would otherwise land it flush
     against the top edge of the window. */
  .prose :global(.footnotes li) {
    scroll-margin-top: var(--sp-8);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
  }
</style>
